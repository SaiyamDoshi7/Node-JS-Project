<div class="task-card priority-<%= task.priority.toLowerCase() %>">
  <div class="d-flex justify-content-between align-items-start">
    <div class="task-title"><%= task.title %></div>
    <div class="dropdown">
      <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-three-dots-vertical"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="/tasks/<%= task._id %>/edit"><i class="bi bi-pencil me-2"></i>Edit</a></li>
        <li>
          <form action="/tasks/<%= task._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this task? This cannot be undone.');">
            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
          </form>
        </li>
      </ul>
    </div>
  </div>

  <p class="task-desc"><%= task.description && task.description.length ? task.description : "No description provided." %></p>

  <div class="d-flex flex-wrap gap-1 mb-2">
    <span class="badge badge-status-<%= task.status.toLowerCase().replace(' ', '-') %>"><%= task.status %></span>
    <span class="badge badge-priority-<%= task.priority.toLowerCase() %>"><%= task.priority %> priority</span>
    <% if (task.category && task.category.categoryName) { %>
      <span class="badge" style="background:#eef1f5; color:#4a5568;"><i class="bi bi-tag"></i> <%= task.category.categoryName %></span>
    <% } %>
  </div>

  <div class="task-meta d-flex justify-content-between align-items-center">
    <span>
      <i class="bi bi-calendar-event"></i>
      <%= task.dueDate ? new Date(task.dueDate).toLocaleDateString() : "No due date" %>
    </span>
    <% if (isAdmin && task.user && task.user.name) { %>
      <span><i class="bi bi-person"></i> <%= task.user.name %></span>
    <% } %>
  </div>
</div>
