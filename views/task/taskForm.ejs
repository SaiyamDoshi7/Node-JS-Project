<%- include("../partials/header") %>

<div class="app-shell">
  <%- include("../partials/navbar", { active: "new-task" }) %>

  <main class="main-content">
    <div class="topbar">
      <div>
        <div class="eyebrow"><%= task ? "Update details" : "New task" %></div>
        <h1><%= title %></h1>
      </div>
      <a href="/tasks" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Tasks</a>
    </div>

    <%- include("../partials/flash") %>

    <div class="card">
      <div class="card-body p-4">
        <form action="<%= formAction %>" method="POST">
          <div class="mb-3">
            <label class="form-label">Task title</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Prepare quarterly report"
              value="<%= task ? task.title : '' %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Add any details about this task..."><%= task ? task.description : '' %></textarea>
          </div>

          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Status</label>
              <select name="status" class="form-select">
                <% ["Pending", "In Progress", "Completed"].forEach(function(s) { %>
                  <option value="<%= s %>" <%= task && task.status === s ? "selected" : "" %>><%= s %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Priority</label>
              <select name="priority" class="form-select">
                <% ["Low", "Medium", "High"].forEach(function(p) { %>
                  <option value="<%= p %>" <%= task && task.priority === p ? "selected" : "" %>><%= p %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Due date</label>
              <input type="date" name="dueDate" class="form-control"
                value="<%= task && task.dueDate ? new Date(task.dueDate).toISOString().split('T')[0] : '' %>">
            </div>
          </div>

          <div class="row">
            <div class="col-md-<%= users && users.length ? 6 : 12 %> mb-3">
              <label class="form-label">Category</label>
              <select name="category" class="form-select">
                <option value="">No category</option>
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat._id %>" <%= task && task.category && task.category.toString() === cat._id.toString() ? "selected" : "" %>>
                    <%= cat.categoryName %>
                  </option>
                <% }); %>
              </select>
              <% if (categories.length === 0) { %>
                <div class="form-text">No categories yet. <a href="/categories/new">Create one</a>.</div>
              <% } %>
            </div>

            <% if (users && users.length) { %>
              <div class="col-md-6 mb-3">
                <label class="form-label">Assign to user <span class="text-muted small">(admin only)</span></label>
                <select name="assignedUser" class="form-select">
                  <% users.forEach(function(u) { %>
                    <option value="<%= u._id %>" <%= task && task.user && task.user.toString() === u._id.toString() ? "selected" : "" %>>
                      <%= u.name %> (<%= u.email %>)
                    </option>
                  <% }); %>
                </select>
              </div>
            <% } %>
          </div>

          <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-accent px-4">
              <i class="bi bi-check2 me-1"></i> <%= task ? "Save Changes" : "Create Task" %>
            </button>
            <a href="/tasks" class="btn btn-outline-secondary px-4">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>

<%- include("../partials/footer") %>
